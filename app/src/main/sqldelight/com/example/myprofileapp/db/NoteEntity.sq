CREATE TABLE NoteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    isFavorite INTEGER AS kotlin.Boolean DEFAULT 0 NOT NULL,
    createdAt INTEGER NOT NULL
);

getAllNotes:
SELECT * FROM NoteEntity ORDER BY createdAt DESC;

getNoteById:
SELECT * FROM NoteEntity WHERE id = :id;

insertNote:
INSERT INTO NoteEntity (title, content, isFavorite, createdAt)
VALUES (?, ?, ?, ?);

updateNote:
UPDATE NoteEntity
SET title = ?, content = ?, isFavorite = ?
WHERE id = ?;

deleteNote:
DELETE FROM NoteEntity WHERE id = :id;

searchNotes:
SELECT * FROM NoteEntity
WHERE title LIKE ('%' || :query || '%') OR content LIKE ('%' || :query || '%')
ORDER BY createdAt DESC;
